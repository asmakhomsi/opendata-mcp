# Copy this file to .env and fill in your own values.
# .env is ignored by git; this example file is committed and must never hold a real key.

# Your DeepSeek API key (secret). Replace the placeholder in .env only.
DEEPSEEK_API_KEY=your_key_here

# DeepSeek model name (not secret). Left empty on purpose: it is set in STEP 1
# after checking DeepSeek's official docs.
DEEPSEEK_MODEL=

# How the agent reaches the data: "mcp" (our MCP server) or "direct" (raw CSV + run_python).
MODE=mcp
