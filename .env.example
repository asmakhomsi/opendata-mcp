# Copy this file to .env and fill in your own values.
# .env is ignored by git; this example file is committed and must never hold a real key.

# Your DeepSeek API key (secret). Replace the placeholder in .env only.
DEEPSEEK_API_KEY=your_key_here

# DeepSeek OpenAI-compatible endpoint (from DeepSeek's docs, api-docs.deepseek.com).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model name (not secret). Current names in DeepSeek's docs: deepseek-flash, deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

# DeepSeek "thinking" (reasoning) mode: enabled or disabled. It is ON by default at DeepSeek,
# so we set it explicitly. The same value is used in both agent modes (fair comparison).
DEEPSEEK_THINKING=disabled

# How the agent reaches the data: "mcp" (our MCP server) or "direct" (raw CSV + run_python).
MODE=mcp
