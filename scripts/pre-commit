#!/bin/sh
# Git pre-commit hook: blocks the commit if results/ contains the DeepSeek key
# (plain, reversed or base64) or the text "sk-". Install it once with:
#   Copy-Item scripts\pre-commit .git\hooks\pre-commit
if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe; else PY=.venv/bin/python; fi
"$PY" scripts/check_secrets.py || { echo "Commit blocked by scripts/check_secrets.py"; exit 1; }
